1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Coming from CEDA 2025:","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"LvWGjdOaUX"}],"key":"O8WBuaA50a"},{"type":"text","value":" global production-weighted factors fall by 23.3%. In a sample of 400 corporate footprints, the median company sees a 14% decrease.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"ra82ox8hpN"}],"key":"mh6UPg7E0h"}],"key":"jkyMGo6Tui"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Coming from USEEIO v1.4:","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"ZbWgfIsh9d"}],"key":"gImTlbvXL6"},{"type":"text","value":" US factors change by −0.8% overall. In the same sample, the median company sees a 1.3% decrease.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"Zfah5vjt5P"}],"key":"o4xpIsPoSy"}],"key":"QCSSgpNabf"}],"key":"cxtH09qoGs"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"A small median can hide large moves in individual sectors, in both directions. See ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"NvaC0WYefg"},{"type":"link","url":"/releases/summary-ceda","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Summary of changes vs. CEDA","key":"lcWVgG6dfg"}],"urlSource":"releases/summary-ceda.md","dataUrl":"/releases.summary-ceda.json","internal":true,"protocol":"file","key":"pPYVvnoCjr"},{"type":"text","value":" and ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"V20CWv6W7z"},{"type":"link","url":"/releases/summary-useeio","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Summary of changes vs. USEEIO","key":"NDLI6psVFA"}],"urlSource":"releases/summary-useeio.md","dataUrl":"/releases.summary-useeio.json","internal":true,"protocol":"file","key":"nae64u4hLf"},{"type":"text","value":".","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"TAbLmWtx5U"}],"key":"gKQWvQFhNV"}],"key":"HJxiMajT5G"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"I was using CEDA or USEEIO. Do I need to rebaseline or restate previous years?","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"wuRYJlaBYg"}],"key":"N1cJ3WYSLu"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"We do expect the majority of companies to be above the SBTi rebaselining threshold, but every company will have a different experience and ultimately whether to restate is a decision under your own company’s policy and your target framework. This year, the release of the time series is designed for exactly this purpose. Because every year from 2017 to 2026 is built with one methodology, you can recalculate prior years on a consistent basis and compare them.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"zJrVyTVcUP"}],"key":"hZjYz68tIB"}],"key":"R2F8WydR1n"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Can I keep using CEDA 2025 or USEEIO for 2026?","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ODZ3h6lDQg"}],"key":"jtfMcO7JU6"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"We recommend using Cornerstone EEIO 2026 for 2026 measurements, since it supersedes both. If you have a reason to stay on a previous version, apply a price index to it, and explain the choice to your verifier.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"QfBhxy9gVu"}],"key":"GV8wxmI7hB"}],"key":"Vwz8GTQJ0b"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"I’d like to explain the switch to Cornerstone in my report. What do you recommend?","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"t4lX1PJVda"}],"key":"wPPst39wuY"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"State the source (Cornerstone EEIO 2026) and the years you are applying the model to.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"NPGTzVvoOX"}],"key":"N9YijgnNsZ"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Suggested wording: “The changes this year are due to adopting Cornerstone EEIO 2026. The Cornerstone model combines CEDA’s global coverage with USEEIO’s detailed US data into a single model that supersedes them both. This model was adopted as an improvement in data quality, as it provides a more current picture of the global economy.”","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"e4HVbSc0jM"}],"key":"Ly7hcljeQ3"}],"key":"dRPWpp3Mw2"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Using the factors","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"aJuWtf6tvU"}],"identifier":"using-the-factors","label":"Using the factors","html_id":"using-the-factors","implicit":true,"key":"RbyAOstdUJ"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"How do I choose between producer and purchaser price?","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"dmFCshMfbm"}],"key":"yobD2Euaq1"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"The producer price is what the producer receives. The purchaser price adds trade and transport margins, and is what you pay for a ready-to-buy product. If you’re unsure, use producer prices, which are more conservative. If you’re confident your spend includes typical margins, for example buying off-the-shelf goods at retail, use purchaser prices. See ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"HzVpfSdCYP"},{"type":"link","url":"/factors/user-guidance","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"User guidance","key":"XOfpZK0Eh1"}],"urlSource":"factors/user-guidance.md","dataUrl":"/factors.user-guidance.json","internal":true,"protocol":"file","key":"jL4hgsirU5"},{"type":"text","value":".","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"sXSxraRIjv"}],"key":"PybX57Atq5"}],"key":"ev0aqKrspp"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"How do I use the factors for goods bought from, or made in, another country?","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"KFozWbDOc5"}],"key":"gxA3bwxnDQ"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Choose the country where the product was produced. If you don’t know it, use this order, from most to least relevant:","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"ucvTVFvbrg"}],"key":"Nq0T1HJCJn"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":94,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[