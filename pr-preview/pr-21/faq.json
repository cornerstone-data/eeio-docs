:1}},"key":"aHgfbiDbIm"}],"key":"P5H4OCgLCJ"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Both. Data updates reflect real-world change, such as new economic, trade and emissions data. Methodology changes reflect modeling improvements, such as modeling US imports by origin and the auto-balanced structural reflection (ABSR) method. See more on the ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"LsHu89EK3J"},{"type":"link","url":"/releases/change-log","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Change log","key":"BwAkLYMGzY"}],"urlSource":"releases/change-log.md","dataUrl":"/releases.change-log.json","internal":true,"protocol":"file","key":"ytLJr1WSlA"},{"type":"text","value":".","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"wjBupJsApz"}],"key":"vcdd3svt6F"}],"key":"IbnhHi984U"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Why is it called a “release candidate”?","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"LA6dxou25J"}],"key":"FMh0L1R2kO"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"2026 is the first time CEDA and USEEIO are combined in one model, and the first time a time series is released. The two-phase release gives companies time to assess the impact on their most recent year of measurements while the time series is under development. The release candidate (2026-rc.1) is published on October 27, 2026. The final version (2026-v0.1), with the 2017–2026 time series, follows in early December 2026. See ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"nmpSh2ebXp"},{"type":"link","url":"/releases/rc","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"2026-rc.1 (Release Candidate)","key":"baVOSD12HA"}],"urlSource":"releases/rc.md","dataUrl":"/releases.rc.json","internal":true,"protocol":"file","key":"XmgqRAd5HX"},{"type":"text","value":".","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"tnoIDb7LrU"}],"key":"bwgDFhFvAh"}],"key":"zm1394Jtxm"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Will the 2024–2026 factors change between the release candidate and the final version?","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"y6MDRBWSk6"}],"key":"C1ds96nuWq"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"We don’t foresee significant changes, but some sector–country combinations could move because of improvements made while developing the time series. If you need numbers for reporting or rebaselining, wait for the final version.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"lzGAAN9yhF"}],"key":"agT9wqiJ9X"}],"key":"Fgpq7Zzh7E"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"When is the next update?","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"LUVMNdOkUg"}],"key":"YUEEfwAPmS"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Releases are published every October so companies can plan for them. The next, Cornerstone EEIO 2027, will be released in October 2027. Cornerstone EEIO 2026 will stay methodologically stable for at least five years, so you have a consistent basis to rebaseline and set targets.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"zOCY8BA4h4"}],"key":"htIOc4aKNf"}],"key":"nf5rBtpFzA"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"