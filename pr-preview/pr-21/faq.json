umn":1}},"key":"uTFwZlBg5f"},{"type":"link","url":"/factors/user-guidance","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"User guidance","key":"Nv8PI0rGIW"}],"urlSource":"factors/user-guidance.md","dataUrl":"/factors.user-guidance.json","internal":true,"protocol":"file","key":"oa5ohrRbJ8"},{"type":"text","value":".","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"oKVfM51S6y"}],"key":"ZAg2Q7cB3q"}],"key":"PKkZokVLf1"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"What if my supplier is in a country with no data?","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"UNafw8nrVE"}],"key":"p3dkbmMZdu"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Use the factor for the region it belongs to, or the global average if the region isn’t clear. See the ","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"pbEEZDsVJb"},{"type":"strong","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Locations","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"JgVx6XJrk9"}],"key":"C1ATccPtJn"},{"type":"text","value":" tab, ","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"tDK6S3cRgD"},{"type":"link","url":"/reference/methods-by-country","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Methods by country","key":"yQGdK7o5UA"}],"urlSource":"reference/methods-by-country.md","dataUrl":"/reference.methods-by-country.json","internal":true,"protocol":"file","key":"tQXWwHs7Uk"},{"type":"text","value":" and ","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"ieDk60gsp3"},{"type":"link","url":"/factors/user-guidance","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"User guidance","key":"sBtocemCpK"}],"urlSource":"factors/user-guidance.md","dataUrl":"/factors.user-guidance.json","internal":true,"protocol":"file","key":"f5UzNX1nr0"},{"type":"text","value":".","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"ZjpUBU4l8I"}],"key":"Cgasi7Ry0H"}],"key":"MlcfulFiPl"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"What do the Scope 3 categories cover?","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"aYR75IJ3u3"}],"key":"cko8OoRlPw"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"The factors cover upstream emissions up to the point of purchase, so they apply to the upstream categories: purchased goods and services (1), capital goods (2), upstream transportation and distribution (4), waste generated in operations (5), business travel (6), and upstream leased assets (8), as well as the upstream part of category 3. They don’t cover downstream emissions (categories 9–15).","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"Yt60ZfAD2o"}],"key":"NYhVlex0o1"}],"key":"y711GH8tND"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Why does the same sector have very different factors in different countries?","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"ytOS9SlyJK"}],"key":"P87bJltf0t"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"Three reasons: the emissions intensity of each country (for example its electricity grid), the economic structure of the sector in that country, and the trade structure, meaning where its inputs are imported from. Factors for a sector in countries with detailed data differ for real reasons, but see the tier question below for countries with less data.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"FkXJZX4kzh"}],"key":"TVHdcDQzvR"}],"key":"zATyzLq6Wu"},{"type":"heading","depth":2,"position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Boundaries and reporting","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"pCymlMA3Fz"}],"identifier":"boundaries-and-reporting","label":"Boundaries and reporting","html_id":"boundaries-and-reporting","implicit":true,"key":"yUhgwCVZfg"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Are the factors suitable for GHG Protocol Scope 3 reporting and for target setting?","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"WQyLCubSrj"}],"key":"pY76D32NWo"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"Yes. Cornerstone factors are designed for spend-based Scope 3 calculations under the GHG Protocol Corporate Value Chain (Scope 3) Standard, and they follow its minimum boundary conditions: a cradle-to-gate boundary that covers all upstream emissions up to the point of purchase, all seven GHGs reported in CO₂e with IPCC AR6 100-year global warming potentials, and no downstream emissions.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"INHCJuFwoN"}],"key":"pqHPEpe26J"}],"key":"jpCtPEN3Kf"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Does Cornerstone EEIO follow a cradle-to-gate boundary?","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"z4Q6m1nXa0"}],"key":"p03tP0BRgA"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Yes. The factors cover all upstream emissions, from raw material extraction up to the point of purchase. Downstream use and end-of-life emissions are not included.","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"K0RxmJy7Il"}],"key":"Z1PYTukZes"}],"key":"OteuNwzHqm"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Does Cornerstone EEIO account for direct land use change and land management emissions?","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"QQiN7nm6Vc"}],"key":"MSyN8x3rlF"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"The factors do not account for direct land use change, but they do include land management emissions. Farming emissions are counted in the farm sectors, including methane from livestock and rice, N₂O from agricultural soils, and CO₂ from liming and urea. Land use, land-use change and forestry (LULUCF), including carbon removals, is not counted.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"cH6mg3DdLB"}],"key":"JQXxrOVka3"}],"key":"R9u0yW9BLv"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Does Cornerstone EEIO exclude any of the seven GHGs (CO₂, CH₄, N₂O, HFCs, PFCs, SF₆, NF₃)?","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"uXHo82LHXI"}],"key":"vVeOkHsDNK"},{"type":"paragraph","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"No. All seven GHGs are included. The release reports each gas separately, alongside the total, in kg CO₂e per USD.","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"r7F7RUCAab"}],"key":"k24ZKNrVfE"}],"key":"dKyY8gHe5r"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Are biogenic emissions included in the factors?","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"qUb6sQPk4T"}],"key":"tEbuH9UvBn"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"No, biogenic emissions are not included.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"ZYRNKae7su"}],"key":"k2Z4EGIfrc"}],"key":"Hx4cT4rbXv"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Which GWP version is used?","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"wPyPIR7jWB"}],"key":"LZsqIgrsgi"},{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"IPCC AR6, 100-year time horizon. Sources that report in AR5 CO₂-equivalents are converted to AR6 gas by gas. Prior versions of USEEIO used earlier GWPs, so a share of the change versus those models comes from the GWP update. Cornerstone EEIO 2026 also fixes a double application of the AR5-to-AR6 conversion.","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"T3zChn8Dlf"}],"key":"dQcvfflC05"}],"key":"skIcaNBKWN"},{"type":"heading","depth":2,"position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Verification, licensing and support","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"IJXVxgjX7f"}],"identifier":"verification-licensing-and-support","label":"Verification, licensing and support","html_id":"verification-licensing-and-support","implicit":true,"key":"xHREIsD5y1"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"How do I trace a factor back to its data sources and methods?","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"iV0Rgkj4yC"}],"key":"dInPeMcTXy"},{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Start with ","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"Wf7dK5sukm"},{"type":"link","url":"/reference/methods-by-country","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Methods by country","key":"OphjrbfxSZ"}],"urlSource":"reference/methods-by-country.md","dataUrl":"/reference.methods-by-country.json","internal":true,"protocol":"file","key":"B3i3biUSkn"},{"type":"text","value":", which lists the data and methods behind every country. The ","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"EXFlBrZvkT"},{"type":"link","url":"/io","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"IO model","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"T3CodOWT6N"}],"urlSource":"io/index.md","dataUrl":"/io.index.json","internal":true,"protocol":"file","key":"bdSetTUptP"},{"type":"text","value":" and ","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"NliPV3Fvv6"},{"type":"link","url":"/ee","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"GHG extension","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"NWjLtA4oel"}],"urlSource":"ee/index.md","dataUrl":"/ee.index.json","internal":true,"protocol":"file","key":"M0dWx9IeDt"},{"type":"text","value":" pages describe the method step by step, and the ","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"MQAxa56iVh"},{"type":"link","url":"/releases/change-log","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Change log","key":"VikuWxNci8"}],"urlSource":"releases/change-log.md","dataUrl":"/releases.change-log.json","intern