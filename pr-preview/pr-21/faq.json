{"version":3,"kind":"Article","sha256":"46843408e122e72dfe2d6ef0f664fb4d221ed835b1cb831bcc4cb5d4ca2c8ea3","slug":"faq","location":"/faq.md","dependencies":[],"frontmatter":{"title":"Frequently asked questions","authors":[{"nameParsed":{"literal":"Cornerstone Sustainability Data Initiative","given":"Cornerstone Sustainability Data","family":"Initiative"},"name":"Cornerstone Sustainability Data Initiative","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cornerstone-data/eeio-docs","keywords":["EEIO","MRIO","input-output","emission factors","Scope 3","greenhouse gas"],"source_url":"https://github.com/cornerstone-data/eeio-docs/blob/main/faq.md","edit_url":"https://github.com/cornerstone-data/eeio-docs/edit/main/faq.md","exports":[{"format":"md","filename":"faq.md","url":"/pr-preview/pr-21/build/faq-9911ddec8ad16e84e3ace32c428125f4.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ENrL5H5hZp"}],"key":"YmYdWAvnM6"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Short answers to the questions we hear most about Cornerstone EEIO 2026. Each answer links to the page with the full explanation. Cornerstone EEIO is the successor of USEEIO and CEDA, so many answers compare it with those models.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VMVcwQbqHq"}],"key":"iakd82zTXM"}],"key":"HtgAkmMsV2"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"About Cornerstone EEIO 2026","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"tkQhn2GpuV"}],"identifier":"about-cornerstone-eeio-2026","label":"About Cornerstone EEIO 2026","html_id":"about-cornerstone-eeio-2026","implicit":true,"key":"ciyeeLeVn9"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"What is the Cornerstone Sustainability Data Initiative, and how does it relate to USEEIO and CEDA?","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"C6u7fo9XvP"}],"key":"A5TbE1Qz3F"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Cornerstone launched in August 2025 to bring USEEIO and CEDA together into one open, comprehensive dataset of Scope 3 spend-based emission factors. Cornerstone EEIO 2026 is the first release of that combined model. It is the continuation of both USEEIO v1.4 and CEDA 2025. Today Cornerstone is the home of 3 additional datasets: eGRID, the GHG EF Hub and Orbae. Learn more at ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"GjEOKXjLwR"},{"type":"link","url":"https://cornerstonedata.org/","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"cornerstonedata.org","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"KTVSxcYnJe"}],"urlSource":"https://cornerstonedata.org/","key":"Uy1xMVtiFQ"},{"type":"text","value":".","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"b5NIhVMK2o"}],"key":"wsVuLrogtv"}],"key":"XkGlLjuBpo"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"What is changing compared with USEEIO and CEDA?","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"rrn8ZtqU1G"}],"key":"g1l2S04aEC"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Three groups of changes:","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"JyzIArt7dW"}],"key":"Sm4C73LZeX"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":18,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"A more current US economy that accounts for imports.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"VbTAz2vYYa"}],"key":"V0j1kTzNQP"},{"type":"text","value":" US tables are rebuilt for every year from 2017 to 2024, manufacturing uses facility-reported emissions, and imports are modeled where they are made.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"rNBAQVlsha"}],"key":"SqfuWcmcHd"}],"key":"ga7YKqiH8W"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Newer data for Europe, the UK and China, and better gap-filling for other countries.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"vYvFqdpdI0"}],"key":"mdJm3tr8U8"}],"key":"SznBRcRmkv"}],"key":"lxA4AOuigI"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"A validation process that feeds back into the model.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"XdrPGlJItj"}],"key":"P0TADQ1GSP"},{"type":"text","value":" Third-party benchmarks review the sectors behind about 50% of global emissions.","position":{"start":{"line":20,"column":1},"end":{"line"