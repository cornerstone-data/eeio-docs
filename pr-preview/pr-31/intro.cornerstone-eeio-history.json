n":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"oOQnUzqIv4"}],"key":"eZswzzOEoA"}],"key":"CXq8xLgKfh"},{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"CEDA","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"TuboYSXzTi"}],"identifier":"ceda","label":"CEDA","html_id":"ceda","implicit":true,"key":"mjnT1FYcRd"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"CEDA dates back to the early 2000s, when Sangwon Suh developed it, first at Leiden University and later at the University of Minnesota ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"KqzHfkrNyM"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"cite","identifier":"suhdevelopingsectoralenvironmental2005","label":"suhDevelopingSectoralEnvironmental2005","kind":"parenthetical","position":{"start":{"line":12,"column":137},"end":{"line":12,"column":176}},"children":[{"type":"text","value":"Suh, 2005","key":"kNTYeLImki"}],"enumerator":"1","key":"c4vsQ8jJBG"}],"key":"CFknN6GcvK"},{"type":"text","value":".\nIt began as a U.S. single-region model with environmental extensions covering many environmental indicators.\nVitalMetrics maintained it and applied it in private, public and academic work.\nCEDA was expanded into a global MRIO model focused on GHG emissions before Watershed acquired it in 2023. Under Watershed, GHG emission factors for Scope 3 reporting became its primary purpose, and in 2025 Watershed released a free version of the emission factors as Open CEDA.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"n8UtifJ5no"}],"key":"Ma43370l2d"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"USEEIO","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"TP2MeUUY6Z"}],"identifier":"useeio","label":"USEEIO","html_id":"useeio","implicit":true,"key":"TTWBDa0WqE"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"USEEIO was a research product of the U.S. Environmental Protection Agency (USEPA), first released in early 2017 and developed as a fully open-source model ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Vr2km4gaZM"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"yanguseeionewtransparent2017","label":"yangUSEEIONewTransparent2017","kind":"parenthetical","position":{"start":{"line":19,"column":157},"end":{"line":19,"column":186}},"children":[{"type":"text","value":"Yang ","key":"dZ8DA9SJfD"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"qafbMUYzjd"}],"key":"nHWNmKoKTG"},{"type":"text","value":", 2017","key":"RK6CdBUiev"}],"enumerator":"2","key":"X595zQmOwy"}],"key":"ggAwczu04g"},{"type":"text","value":".\nUSEEIO built on the contributions of earlier U.S. single-region EEIO models, including the Carnegie Mellon EIO-LCA model ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"wOxgkwZeXu"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"hendricksoneconomicinputoutput1998","label":"hendricksonEconomicInputOutput1998","kind":"parenthetical","position":{"start":{"line":19,"column":311},"end":{"line":19,"column":346}},"children":[{"type":"text","value":"Hendrickson ","key":"VVKG06IRvn"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"kX6O2RNhdr"}],"key":"LuFrMLpXDt"},{"type":"text","value":", 1998","key":"j3CqwEK418"}],"enumerator":"3","key":"wzv6cnacBB"},{"type":"cite","identifier":"weber20092002","label":"weber20092002","kind":"parenthetical","position":{"start":{"line":19,"column":347},"end":{"line":19,"column":361}},"children":[{"type":"text","value":"Weber ","key":"B7xn6UEwvc"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"OXjalb8ibj"}],"key":"nar2DaZEe9"},{"type":"text","value":", 2009","key":"bz8WqqugZN"}],"enumerator":"4","key":"wemhvgFTqB"}],"key":"kigtZFeh9q"},{"type":"text","value":", openIO ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"PbvAerqsfv"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"cox2011open","label":"cox2011open","kind":"parenthetical","position":{"start":{"line":19,"column":372},"end":{"line":19,"column":384}},"children":[{"type":"text","value":"Cox & Norris, 2011","key":"Bsm6W75R8y"}],"enumerator":"5","key":"uJjfsmp9RF"}],"key":"hCrn9pVQBa"},{"type":"text","value":", and CEDA. Its primary versions are v1 and v2.0 ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"uyDbTpehAc"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"ingwersenuseeiov20us2022a","label":"ingwersenUSEEIOV20US2022a","kind":"parenthetical","position":{"start":{"line":19,"column":435},"end":{"line":19,"column":461}},"children":[{"type":"text","value":"Ingwersen ","key":"yeztQVrROD"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"Us2fn1lFkA"}],"key":"BOmDm4HGO6"},{"type":"text","value":", 2022","key":"b2lZ4853T6"}],"enumerator":"6","key":"rbFu8tJdXl"}],"key":"kYZIBVv54i"},{"type":"text","value":".\nUSEEIO was initially developed for multi-indicator assessments for the USEPA’s Sustainable Materials Management program.\nBeginning in 2020, the Supply Chain GHG Emission Factors were created from USEEIO for Scope 3 reporting, first at the request of the USEPA Center for Corporate Climate Leadership and later at the request of the White House Office of Sustainability and the General Services Administration ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"IYK5rf9Dp8"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"ingwersensupplychaingreenhouse2020","label":"ingwersenSupplyChainGreenhouse2020","kind":"parenthetical","position":{"start":{"line":19,"column":874},"end":{"line":19,"column":909}},"children":[{"type":"text","value":"Ingwersen & Li, 2020","key":"SvCcs5G7mq"}],"enumerator":"7","key":"WSJxR8K6H4"},{"type":"cite","identifier":"ingwersen_supply_2024","label":"ingwersen_supply_2024","kind":"parenthetical","position":{"start":{"line":19,"column":910},"end":{"line":19,"column":932}},"children":[{"type":"text","value":"Ingwersen, 2024","key":"NG2PT5PWsN"}],"enumerator":"8","key":"mXTqSKUrFL"}],"key":"f3iDLfumoZ"},{"type":"text","value":". They became the most popular use of the model and one of the USEPA’s most popular open-source datasets.\nThe limitations of a single-region model for estimating consumption-based impacts in the U.S. were addressed in later v2 models by coupling them with global MRIO models ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"YKn5Yppweq"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"ingwersenestimatingembodiedenvironmental2024","label":"ingwersenEstimatingEmbodiedEnvironmental2024","kind":"parenthetical","position":{"start":{"line":19,"column":1209},"end":{"line":19,"column":1254}},"children":[{"type":"text","value":"Ingwersen ","key":"BWgcqwSO1V"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"uiylsZNbUq"}],"key":"T3irAR45hn"},{"type":"text","value":", 2024","key":"QWwbWlubAw"}],"enumerator":"9","key":"ygxOeQLPE0"}],"key":"vA6oybdgxb"},{"type":"text","value":", one of which was CEDA ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"nJU6nAE7Rn"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"ingwersenuseeiomodelsimport2024","label":"ingwersenUSEEIOModelsImport2024","kind":"parenthetical","position":{"start":{"line":19,"column":1280},"end":{"line":19,"column":1312}},"children":[{"type":"text","value":"Ingwersen ","key":"wbanF6CrDS"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"JoFGRx0e2q"}],"key":"PldrfsbA72"},{"type":"text","value":", 2024","key":"tX7NDTa8FN"}],"enumerator":"10","key":"FojAT7gD6h"}],"key":"ze0FA12HZr"},{"type":"text","value":".\nThe USEPA ceased updating the USEEIO models in 2025 ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"jtQcziy1Or"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"cite","identifier":"stevenspopularepadatabase2025","label":"stevensPopularEPADatabase2025","kind":"parenthetical","position":{"start":{"line":19,"column":1368},"end":{"line":19,"column":1398}},"children":[{"type":"text","value":"Stevens, 2025","key":"J825yhXhH5"}],"enumerator":"11","key":"J72ctKGmbK"}],"key":"GUhs6naCYF"},{"type":"text","value":".","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Uy1Lx08WHS"}],"key":"apP9snNhvr"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Cornerstone EEIO","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"j23eY0KTd9"}],"identifier":"cornerstone-eeio","label":"Cornerstone EEIO","html_id":"cornerstone-eeio","implicit":true,"key":"OlNMpEgTpf"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"A primary motivation for forming the Cornerstone Sustainability Data Initiative (Cornerstone) was to continue the USEEIO model and to bring it together with CEDA ","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"LkgYfSt4rq"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"cite","identifier":"watershedsolidifyingfoundationsglobal2025","label":"watershedSolidifyingFoundationsGlobal2025","kind":"parenthetical","position":{"start":{"line":28,"column":164},"end":{"line":28,"column":206}},"children":[{"type":"text","value":"Watershed, 2025","key":"AZLzuQX80d"}],"enumerator":"12","key":"YD4XlJpkSQ"}],"key":"ZuYl1M4W6D"},{"type":"text","value":".\nAlthough the ","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"cPsfxpLA1U"},{"type":"link","url":"/releases","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"first release","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"q1ALuhM6fI"}],"urlSource":"../releases/index.md","dataUrl":"/releases.index.json","internal":true,"protocol":"file","key":"L8zmeOyrIF"},{"type":"text","value":" of Cornerstone EEIO came in 2026, the model is “new” only in that it reconciles the methods behind USEEIO and CEDA, adds major methodological innovations such as ABSR and nowcast U.S. tables, and is assembled through a new data pipeline. Read more about these innovations in ","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"UK7pytu0ou"},{"type":"link","url":"/releases","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Releases