eio-docs/pr-preview/pr-29/build/summary-vs-useeio-c4adde9f4597b1d8df8a15e55c4ac640.png","alt":"Waterfall chart of the US emission factor. From USEEIO v1.4 at 0.2474, data updates add 0.4% and methodology changes remove 1.2%, ending at 0.2454 for Cornerstone 2026, 0.8% lower.","width":"80%","key":"WPb1CJHZAq","urlSource":"../images/summary-vs-useeio.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"summary-vs-useeio","identifier":"summary-vs-useeio","html_id":"summary-vs-useeio","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"coOFHIhQPG"},{"type":"text","value":"1","key":"yWY6v0Rf9F"},{"type":"text","value":":","key":"RvJwBDFwt1"}],"template":"Figure %s:","key":"A57ZYcDdKO"},{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Cornerstone 2026 against USEEIO v1.4 (US).","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"EQlnEa2Y1N"}],"key":"eHNQiI5c1d"},{"type":"text","value":" US production-weighted total emission factor, in kg CO₂e per 2024 USD, split into data updates and methodology changes.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"GkaPkI2JA2"}],"key":"wC60d8EXqk"}],"key":"EOI264gbD4"}],"label":"summary-vs-useeio","identifier":"summary-vs-useeio","enumerator":"1","html_id":"summary-vs-useeio","key":"qAXxwdigEi"},{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Your footprint may not follow the median","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"SUAu2Xar00"}],"key":"ScnGalZYxK"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"A company’s change depends on which sectors and countries its spend falls in. A small median can hide large moves in individual sectors, in both directions. From a sample of 400 corporate footprints, the median company will experience a decrease of 1.3%.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"ioBoPAnN3R"}],"key":"pDcGAPlrXP"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio-docs/pr-preview/pr-29/build/company-footprint-ch-16343d816d61162ee71db30cba8121ff.png","alt":"Histogram of the change in the footprint of 400 companies against USEEIO. Most companies change by less than 20% in either direction, clustered around zero, with a median of a 1.3% decrease and a few companies changing by more than 20%.","width":"90%","key":"UL4AE9Ah1S","urlSource":"../images/company-footprint-change.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"company-footprint-change","identifier":"company-footprint-change","html_id":"company-footprint-change","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"dOomI5xnr1"},{"type":"text","value":"2","key":"H508OeSeVz"},{"type":"text","value":":","key":"okXDYEPcys"}],"template":"Figure %s:","key":"vU7eGbbxUz"},{"type":"strong","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Change in the footprint of 400 companies, Cornerstone 2026 against USEEIO v1.4.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"WB6ZaBzO8A"}],"key":"IGZ30U3lPO"},{"type":"text","value":" Each bar groups companies by the percentage change in their total footprint. Bars outside the shaded ±20% band are in green. Bar heights are approximate.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ZP3PY584Nq"}],"key":"DkqHgMqWxu"}],"key":"zYCkVMk6J3"}],"label":"company-footprint-change","identifier":"company-footprint-change","enumerator":"2","html_id":"company-footprint-change","key":"N5pNAxK3YQ"}],"class":"dropdown","key":"kfr7FtraQg"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"What drives the change for USEEIO users","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"uLquIlHWOp"}],"identifier":"what-drives-the-change-for-useeio-users","label":"What drives the change for USEEIO users","html_id":"what-drives-the-change-for-useeio-users","implicit":true,"key":"zBaxcDU3q9"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Three changes drive ~95% of the impact: model reconciliation, nowcasting and facility-reported data, and the modeling of imports.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"PebeC2DKxN"}],"key":"HA3UeZxiUc"},{"type":"container","kind":"figure","children":[{"type":"iframe","src":"../../interactive/drivers-waterfall.html?d=useeio","width":"100%","key":"WR3T7fCl3U"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"drivers-vs-useeio","identifier":"drivers-vs-useeio","html_id":"drivers-vs-useeio","enumerator":"3","children":[{"type":"text","value":"Figure ","key":"pAIoNCEbTk"},{"type":"text","value":"3","key":"yCHPQKqaHS"},{"type":"text","value":":","key":"cTk8SS6SAJ"}],"template":"Figure %s:","key":"Ngp4zOomQI"},{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Change in the US production-weighted emission factor from USEEIO v1.4 to Cornerstone 2026, by driver.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"MT0M1kvbll"}],"key":"ygWzlOIlfq"},{"type":"text","value":" Percentages are changes relative to the USEEIO baseline. Hover over a bar for details. The vertical axis does not start at zero.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"PkL7msAgtv"}],"key":"a3GZfnm20g"}],"key":"E046Ey0MiO"}],"label":"drivers-vs-useeio","identifier":"drivers-vs-useeio","enumerator":"3","html_id":"drivers-vs-useeio","key":"YkqN584775"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Model reconciliation","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"sQRh80mcb4"}],"identifier":"model-reconciliation","label":"Model reconciliation","html_id":"model-reconciliation","implicit":true,"key":"zn0xM9z9Hn"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"The USEEIO and CEDA teams reviewed 18 differences between the two models for the US. For each, they adopted one model’s approach or proposed an improvement. The differences can be categorized into 3 types: sectors schema, treatment of economic data and GHG attribution. For details on the differences, see the ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"gBSCaKyP5M"},{"type":"crossReference","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"model reconciliation section","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"mRgWglNNhs"}],"identifier":"change-log-model-reconciliation","label":"change-log-model-reconciliation","kind":"heading","template":"{name}","resolved":true,"html_id":"change-log-model-reconciliation","remote":true,"url":"/releases/change-log","dataUrl":"/releases.change-log.json","key":"qt6sh0VXag"},{"type":"text","value":" of the change log.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"E8op15ceB2"}],"key":"jehkLo5zyX"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"One example of these differences is using the BEA after redefinition input output tables instead of the before redefinition tables. A detailed explanation of why this is the approach can be found on GitHub ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ixyZgt1of4"},{"type":"link","url":"https://github.com/cornerstone-data/methods/discussions/3","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"here","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"I8g13t25Ku"}],"urlSource":"https://github.com/cornerstone-data/methods/discussions/3","error":true,"key":"OD3Jg3yRBA"},{"type":"text","value":".","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"B2GM6fsxaS"}],"key":"JMBXMo10CW"},{"type":"heading","depth":3,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Nowcasting and facility-reported data","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"aTLzaClIFs"}],"identifier":"nowcasting-and-facility-reported-data","label":"Nowcasting and facility-reported data","html_id":"nowcasting-and-facility-reported-data","implicit":true,"key":"P7Sk7pOA6u"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"BEA publishes detailed (about 400-sector) US input-output tables only every 10 years, with a five-year lag. The latest is for 2017. Nowcasting rebuilds these tables for every year from 2017 to 2024, in BEA’s own structure, using the same official statistics BEA uses. This methodology improvement enables building the time series and providing a more current picture of the US economy. More than 50% of the economic data behind the factors is now backed by reported annual data, beyond inflation adjustments.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"kKc66RWgm0"}],"key":"fzck8WgK2R"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Cornerstone EEIO also uses facility-level reported emissions data from the US EPA’s Greenhouse Gas Reporting Program (GHGRP) where most of the facilities in a sector report them, in place of using estimates based on 4-yr frequency fuel use data. The 2024 data includes 6,127 facility reports across 84 industries. This improvement provides a more accurate picture of the US economy. For example, the US sector emissions now match the totals reported across 87 cement plants (61 MT) in 2024. USEEIO undercounted them by ~20%, driving an increase in emission factors in kg CO₂e/USD.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"IjL7Khrzt0"}],"key":"mjzVWKgyWZ"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio-docs/pr-preview/pr-29/build/cement-ef-fee2edb872717645691c3f4f3ef44601.png","alt":"Bar chart of the cement sector emission factor in kg CO₂e per USD. USEEIO 4.35, Cornerstone 5.21.","width":"60%","key":"SNrV9C0Ifl","urlSource":"../images/cement-ef.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"cement-ef","identifier":"cement-ef","html_id":"cement-ef","enumerator":"4","children":[{"type":"text","value":"Figure ","key":"PhGbjhocFQ"},{"type":"text","value":"4","key":"ZywSTAxHMB"},{"type":"text","value":":","key":"MiWSf5TqVr"}],"template":"Figure %s:","key":"sEfYs9LM6g"},{"type":"strong","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Cement sector emission factor, USEEIO v1.4 and Cornerstone 2026.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"MXehYWodPt"}],"key":"ksi8BqyJ3e"},{"type":"text","value":" In kg CO₂e per USD.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"xdPP9SfP7T"}],"key":"r7tc2Tv1EH"}],"key":"sC2kpOHQVt"}],"label":"cement-ef","identifier":"cement-ef","enumerator":"4","html_id":"cement-ef","key":"EYMA97MNaG"},{"type":"heading","depth":3,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Trade impact: modeling imports","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"Juapv5wS2K"}],"identifier":"trade-impact-modeling-imports","label":"Trade impact: modeling imports","html_id":"trade-impact-modeling-imports","implicit":true,"key":"IDBvRsmqrl"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"USEEIO treated the US as a closed economy: every product used in the US was assumed to be made in the US. Cornerstone uses trade data to model each import in the country that produced it. Many imports come from more emissions-intensive economies such as China and India, so US factors tend to rise by 10 to 30% on average. This is the main upward pressure and the main reason for the change for USEEIO users.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"rGpfOQlFdN"}],"key":"rCMSXEwQwt"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"One example is light trucks and utility vehicles. The US factor rises by ~24%, mostly because many of their components are now modeled as imports from the countries that make them. Public data suggests that about 60% of the components of a US-assembled light truck are imported, with Mexico the largest source, followed by Europe and Canada (see ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"GBHlpQwZ7l"},{"type":"crossReference","kind":"figure","identifier":"us-parts-imports","label":"us-parts-imports","children":[{"type":"text","value":"Figure ","key":"wlLziqtd63"},{"type":"text","value":"5","key":"h4neqOeQ4r"}],"template":"Figure %s","enumerator":"5","resolved":true,"html_id":"us-parts-imports","key":"rHLPPvA5vu"},{"type":"text","value":").","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"D1afEKh57e"}],"key":"DJua9Cgzv3"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eeio-docs/pr-preview/pr-29/build/rc-us-parts-imports-0649c2e7af9b3308ff1e27cd3d71b34a.png","alt":"One horizontal stacked bar showing the estimated origin of light-truck components. Made in the US 41%. Imported: Mexico 24%, Europe 7%, Canada 6%, China 5%, Japan 5%, ASEAN 4%, South Korea 4%, other 4%.","width":"100%","key":"eMqDrw6jLB","urlSource":"../images/rc-us-parts-imports.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"us-parts-imports","identifier":"us-parts-imports","html_id":"us-parts-imports","enumerator":"5","children":[{"type":"text","value":"Figure ","key":"eCsnpGmKh3"},{"type":"text","value":"5","key":"lbxEchDMSO"},{"type":"text","value":":","key":"uQzwkDeLNN"}],"template":"Figure %s:","key":"Wb2A7T71FH"},{"type":"strong","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Estimated origin of the components of a US-assembled light truck.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"HMIpFLq9wb"}],"key":"ua1yXT3skb"},{"type":"text","value":" Sources: ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"iPheZQmz7C"},{"type":"link","url":"https://www.nhtsa.gov/part-583-american-automobile-labeling-act-reports","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"NHTSA AALA parts content data","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"UY5FuPNAC2"}],"urlSource":"https://www.nhtsa.gov/part-583-american-automobile-labeling-act-reports","key":"efVRwFPNU9"},{"type":"text","value":"; ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"yN3CRp29CR"},{"type":"link","url":"https://www.mnimarkets.com/articles/us-auto-tariffs-impact-broad-based-across-regions-1743036084321","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"International Trade Administration data as reported by MNI (March 2025)","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"UV4JNtnUZI"}],"urlSource":"https://www.mnimarkets.com/articles/us-auto-tariffs-impact-broad-based-across-regions-1743036084321","key":"WmVqNloTYx"},{"type":"text","value":".","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"td89nDxccT"}],"key":"wsnrTwbXtp"}],"key":"p3VwcRo6Zy"}],"label":"us-parts-imports","identifier":"us-parts-imports","enumerator":"5","html_id":"us-parts-imports","key":"yBMSTDVL3P"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"For the full list of data and methodology changes, see the ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"Bsh0JlnGr3"},{"type":"link","url":"/releases/change-log","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Change log","key":"hsXPhejvnU"}],"urlSource":"change-log.md","dataUrl":"/releases.change-log.json","internal":true,"protocol":"file","key":"dyLDza2n2h"},{"type":"text","value":". For the equivalent summary against CEDA, see ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key