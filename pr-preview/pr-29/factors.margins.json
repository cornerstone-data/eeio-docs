{"version":3,"kind":"Article","sha256":"eb365e2462a9b593c1f75798da3fd06710a0705bceccefd2effb75d80dd3436d","slug":"factors.margins","location":"/factors/margins.md","dependencies":[],"frontmatter":{"title":"Margin emission factors","authors":[{"nameParsed":{"literal":"Cornerstone Sustainability Data Initiative","given":"Cornerstone Sustainability Data","family":"Initiative"},"name":"Cornerstone Sustainability Data Initiative","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cornerstone-data/eeio-docs","keywords":["EEIO","MRIO","input-output","emission factors","Scope 3","greenhouse gas"],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/cornerstone-data/eeio-docs/blob/main/factors/margins.md","edit_url":"https://github.com/cornerstone-data/eeio-docs/edit/main/factors/margins.md","thumbnail":"/eeio-docs/pr-preview/pr-29/build/margin-dollar-eac8d9e4fe1c5a0bc43c92b7fee0e4ae.svg","exports":[{"format":"md","filename":"margins.md","url":"/eeio-docs/pr-preview/pr-29/build/margins-69db43d2a6d3e3735576b7e8d3f55901.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"AKxhQCFAjO"}],"key":"Kg1hoQvnTW"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Margin emission factors give the emissions of the wholesale, retail and transportation services that deliver a good from its producer to its buyer, per dollar of purchaser price. They are prepared for U.S. commodities only, for each year, and can be added to the U.S. purchaser-price factors when those delivery emissions are not counted elsewhere in a footprint. They mainly serve former USEEIO users, whose factors had a margin component.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},