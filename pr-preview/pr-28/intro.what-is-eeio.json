y":"ahX1P5UXvj"}],"urlSource":"../reference/notation.md","dataUrl":"/reference.notation.json","internal":true,"protocol":"file","key":"kFwiH5dipv"},{"type":"text","value":"). Input-output analysis then combines the matrices with matrix algebra.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"gOeNyjlwV9"}],"key":"vW5YNkbBQh"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":23,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Input-output tables.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"vUahQTNIBF"}],"key":"xnMQCp7yRN"},{"type":"text","value":" The supply (","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"kdIEPsULhN"},{"type":"inlineCode","value":"V","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"oZ6NIgglDv"},{"type":"text","value":") and use (","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"BM3DN6p34F"},{"type":"inlineCode","value":"U","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"MvR881HD3R"},{"type":"text","value":") tables record which sectors produce which products, and which products each sector and final user buys. From them come the direct requirements (","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"oB3ViMeYcQ"},{"type":"inlineCode","value":"A","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"khB7wvPK6z"},{"type":"text","value":"), the inputs a sector buys per dollar of its output, and the total requirements (","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"AGrIzbakbM"},{"type":"inlineCode","value":"L","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"b9YFdJjHtz"},{"type":"text","value":", the Leontief inverse), which add up the purchases through every round of suppliers. See ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"cAUAH0qTZV"},{"type":"link","url":"/io","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"The IO model: overview","key":"aAn72PYwsW"}],"urlSource":"../io/index.md","dataUrl":"/io.index.json","internal":true,"protocol":"file","key":"T8bHAMi79Y"},{"type":"text","value":".","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"rg9ogz42Yk"}],"key":"qc61N3zowz"}],"key":"EQ6DFtMv6y"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Environmental extension.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"aENL1hFHDj"}],"key":"EyNFpyaJxe"},{"type":"text","value":" Emissions of each gas by each sector (","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"eWLkwcs7Dt"},{"type":"inlineCode","value":"E","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"sKDBycZIEL"},{"type":"text","value":"), weighted by each gas’s global warming potential to give CO₂-equivalent and divided by the sector’s output, give the direct emission intensities (","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"bDg0ZdTCnH"},{"type":"inlineCode","value":"B","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"cwXRJNqwUc"},{"type":"text","value":"). See ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ZbzJh2cqSS"},{"type":"link","url":"/ee","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"The GHG extension: overview","key":"geVeLgkn85"}],"urlSource":"../ee/index.md","dataUrl":"/ee.index.json","internal":true,"protocol":"file","key":"XTbGxeuLLw"},{"type":"text","value":".","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"jxLTEFa1Fx"}],"key":"lWASEkk4m0"}],"key":"VIOK0dhnRa"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Emission factors.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"TNOvVt9L5a"}],"key":"RZW7AyGWsx"},{"type":"text","value":" Adding up the gases in ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"O5bRiz4WID"},{"type":"inlineCode","value":"B","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"wGfYhNcSc1"},{"type":"text","value":" gives the direct emission factors (","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"H7yKBRZGb5"},{"type":"inlineCode","value":"D","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"XYlkek7pXj"},{"type":"text","value":"), for what a sector emits itself. Combining them with the IO tables gives the total emission factors, ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"lDCKzf6UjB"},{"type":"inlineCode","value":"N = D × L","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"sJkMMaFJCO"},{"type":"text","value":", for what is emitted across its whole supply chain.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"R7qYYYCDrR"}],"key":"m7XbKQmrbf"}],"key":"FSltus9Eqj"}],"key":"ZgPgSWKd92"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"EEIO and life cycle assessment","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"oJymvlvMnP"}],"identifier":"eeio-and-life-cycle-assessment","label":"EEIO and life cycle assessment","html_id":"eeio-and-life-cycle-assessment","implicit":true,"key":"oBywjCQAvz"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"An EEIO model has the same matrix structure as the models used for life cycle assessment (LCA) ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"SdkzSiq57p"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"cite","identifier":"suhdevelopingsectoralenvironmental2005","label":"suhDevelopingSectoralEnvironmental2005","kind":"parenthetical","position":{"start":{"line":29,"column":97},"end":{"line":29,"column":136}},"children":[{"type":"text","value":"Suh, 2005","key":"u7u06k0KlG"}],"enumerator":"3","key":"Za8p1opa2b"}],"key":"R2rdYwQSdg"},{"type":"text","value":". In both, a matrix of the inputs each activity needs is inverted to trace every upstream supplier, and a matrix of emissions per unit of each activity is multiplied through it. The difference is that EEIO describes sectors in dollars, where LCA usually describes individual processes in physical units. Because of this shared structure, EEIO data can serve as background data in LCA, as discussed in ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"rGitO3ArcO"},{"type":"citeGroup","kind":"narrative","children":[{"type":"cite","kind":"narrative","label":"ingwersenConsideringInputoutputDerived2026","identifier":"ingwersenconsideringinputoutputderived2026","children":[{"type":"text","value":"Ingwersen (2026)","key":"GNInnqZtO8"}],"enumerator":"4","key":"xWvbDvao7A"}],"key":"CGl4qQVIAe"},{"type":"text","value":".","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"WPdWtMF8ED"}],"key":"L6VcGIlEc6"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Multi-regional models","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"V94URQURuT"}],"identifier":"multi-regional-models","label":"Multi-regional models","html_id":"multi-regional-models","implicit":true,"key":"KIJYTtik2b"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"A single-country model assumes imported products are made the same way, and with the same emissions, as products made at home. A multi-regional input-output (","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"o5hjfNF4na"},{"type":"crossReference","label":"MRIO","identifier":"term-mrio","children":[{"type":"text","value":"MRIO","key":"otPnZ5GEU9"}],"kind":"definitionTerm","template":"{name}","resolved":true,"html_id":"term-mrio","remote":true,"url":"/reference/glossary","dataUrl":"/reference.glossary.json","key":"ZTU3sNTUkE"},{"type":"text","value":") model instead links countries’ input-output tables through international trade, so each import carries the supply chain and emissions as it was produced in the origin country. For the companies reporting to the Carbon Disclosure Project (CDP), in one study using an MRIO model instead of a U.S. single-region model raised their estimated upstream emissions by about 10% ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"zmLgd5SdVa"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"cite","identifier":"davisimportancemultiregionalaccounti