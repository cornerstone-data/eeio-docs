@article{minxInputOutputAnalysisCarbon2009,
  ids = {minx_inputoutput_2009},
  title = {Input-{{Output Analysis}} and {{Carbon Footprinting}}: {{An Overview}} of {{Applications}}},
  shorttitle = {Input-{{Output Analysis}} and {{Carbon Footprinting}}},
  author = {Minx, J.c. and Wiedmann, T. and Wood, R. and Peters, G.p. and Lenzen, M. and Owen, A. and Scott, K. and Barrett, J. and Hubacek, K. and Baiocchi, G. and Paul, A. and Dawkins, E. and Briggs, J. and Guan, D. and Suh, S. and Ackerman, F.},
  date = {2009-09},
  journaltitle = {Economic Systems Research},
  volume = {21},
  number = {3},
  pages = {187--216},
  issn = {09535314},
  doi = {10.1080/09535310903541298},
  abstract = {This article provides an overview of how generalised multi-regional input-output models can be used for carbon footprint applications. We focus on the relevance and suitability of such evidence to inform decision making. Such an overview is currently missing. Drawing on UK results, we cover carbon footprint applications in seven areas: national emissions inventories and trade, emission drivers, economic sectors, supply chains, organisations, household consumption and lifestyles as well as sub-national emission inventories. The article highlights the multiple uses of generalised multi-regional input-output models for carbon footprinting and concludes by highlighting important avenues for future research.},
  keywords = {Carbon footprint,CONSUMPTION (Economics),Consumption-based accounting,DECISION making,ECOLOGICAL impact,Emission inventory,INPUT-output analysis,Multi-regional input-output model,Multi-regional input–output model,SUPPLY chains,Trade},
}

